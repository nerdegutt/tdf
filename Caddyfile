# Oppfører seg som vercel.json på Vercel: rene adresser (/dag/1 → dag/1/index.html), ingen skråstrek på slutten,
# /index.html sendes til ren adresse, ukjente adresser gir 404, og PDF-en hentes fra GitHub-releasen.
{
	admin off
	auto_https off
}

# Sikkerhetsheadere, like i alle Caddy-appene. HSTS settes i Cloudflare, ikke her. Importeres både i site-blokken
# og i handle_errors, ellers mister feilsvar (404, 403) headerne og får «Server: Caddy» tilbake.
(sikkerhet) {
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
}

:3000 {
	import sikkerhet
	root * /srv
	respond /healthz "ok" 200
	header Cache-Control "no-cache"

	redir /tdf-reise.pdf https://github.com/nerdegutt/tdf/releases/download/latest-pdf/tdf-reise.pdf 307
	redir /index.html / 308
	# Stien er dekodet, og nettlesere leser «\» som «/» og fjerner tab og linjeskift. Uten unntakene ville
	# /%5Cevil.com/ og /%09/evil.com/ sende til evil.com (åpen videresending), så slike stier får 404.
	@index path_regexp index ^(/[^/\\[:cntrl:]][^\\[:cntrl:]]*)/index\.html$
	redir @index {re.index.1} 308
	@slash path_regexp slash ^(/[^/\\[:cntrl:]][^\\[:cntrl:]]*)/$
	redir @slash {re.slash.1} 308

	try_files {path} {path}/index.html
	file_server {
		disable_canonical_uris
	}
	handle_errors {
		import sikkerhet
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
	log {
		output stdout
	}
}
